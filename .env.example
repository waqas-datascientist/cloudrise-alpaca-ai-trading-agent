# demo = zero-credential replay; paper = autonomous Alpaca paper execution
CLOUDRISE_MODE=demo

# Required only when CLOUDRISE_MODE=paper. Never commit real values.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Risk policy
CLOUDRISE_UNIVERSE=SPY,QQQ,IWM
MAX_DAILY_LOSS_PCT=0.015
MAX_RISK_PER_TRADE_PCT=0.006
MAX_PORTFOLIO_RISK_PCT=0.025
MIN_CONFIDENCE=0.62
MAX_OPEN_SPREADS=3
MIN_DTE=7
MAX_DTE=21
SCAN_INTERVAL_MINUTES=15

# ALPACA_LIVE_TRADE must remain unset. CloudRise rejects live mode.

